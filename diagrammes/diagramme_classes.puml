@startuml

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

title Diagramme de classes Laboratoire 5

'PATRON OBSERVER'
package "Patron Observer" <<Rectangle>> {
    interface Observateur {
        + miseAJour() : void
    }

    abstract class SujetObservable {
        - observateurs : List<Observateur>
        + ajouterObservateur(obs : Observateur) : void
        + retirerObservateur(obs : Observateur) : void
        + notifierObservateurs() : void
    }

    SujetObservable o--> "*" Observateur : notifie
}

'MODÈLE'
package "Modèle" <<Rectangle>> {
    class ImageModele extends SujetObservable {
        - cheminImage : String
        - image : Image
        + chargerImage(chemin : String) : void
        + getImage() : Image
        + getCheminImage() : String
        + estChargee() : boolean
    }

    class Perspective extends SujetObservable {
        - translateX : double
        - translateY : double
        - zoom : double
        + getTranslateX() : double
        + getTranslateY() : double
        + getZoom() : double
        + setTranslation(x : double, y : double) : void
        + setZoom(zoom : double) : void
        + copier() : Perspective
        + restaurer(autre : Perspective) : void
        + sauvegarderEtat() : PerspectiveMemento
        + restaurerEtat(memento : PerspectiveMemento) : void
    }
}

'MEMENTO'
package "Patron Memento" <<Rectangle>> {
    class PerspectiveMemento {
        - zoom : double
        - translationX : double
        - translationY : double
        + getZoom() : double
        + getTranslationX() : double
        + getTranslationY() : double
    }
}


'PATRON COMMAND'
package "Patron Command" <<Rectangle>> {
    interface Commande {
        + executer() : void
        + annuler() : void
    }

    class CommandePerspective implements Commande {
        - cible : Perspective
        - avant : Perspective
        - apres : Perspective
        + executer() : void
        + annuler() : void
    }
}

'PATRON SINGLETON'
package "Patron Singleton" <<Rectangle>> {
    class GestionnaireCommande {
        - {static} instance : GestionnaireCommande
        - historique : Stack<Commande>
        - redo : Stack<Commande>
        - GestionnaireCommande()
        + {static} getInstance() : GestionnaireCommande
        + executerCommande(cmd : Commande) : void
        + ajouterCommande(cmd : Commande) : void
        + annulerDerniereCommande() : void
        + refaireDerniereCommande() : void
    }
}

'PATRON STRATEGY'
package "Patron Strategy" <<Rectangle>> {
    interface CopieStrategie {
        + appliquer(source : PerspectiveMemento, destination : Perspective) : void
    }

    class StrategieCopieZoom implements CopieStrategie {
        + appliquer(source : PerspectiveMemento, destination : Perspective) : void
    }

    class StrategieCopieTranslation implements CopieStrategie {
        + appliquer(source : PerspectiveMemento, destination : Perspective) : void
    }

    class StrategieCopieTout implements CopieStrategie {
        + appliquer(source : PerspectiveMemento, destination : Perspective) : void
    }
}

'PATRON MEDIATOR'
package "Patron Mediator" <<Rectangle>> {
    class PressePapierMediateur {
        - {static} instance : PressePapierMediateur
        - donneesCopiees : PerspectiveMemento
        - strategieCourante : CopieStrategie
        - PressePapierMediateur()
        + {static} getInstance() : PressePapierMediateur
        + setStrategie(strategie : CopieStrategie) : void
        + copier(source : Perspective) : void
        + coller(destination : Perspective) : void
        + estVide() : boolean
    }
}

'VUES'
package "Vues" <<Rectangle>> {
    class VueVignette implements Observateur {
        - canvas : Canvas
        - imageModele : ImageModele
        + miseAJour() : void
        - dessiner() : void
    }

    class VuePerspective implements Observateur {
        - canvas : Canvas
        - imageModele : ImageModele
        - perspective : Perspective
        + miseAJour() : void
        - dessiner() : void
        - configurerSouris() : void
        + getPerspective() : Perspective
    }
}

'SÉRIALISATION'
package "Sérialisation" <<Rectangle>> {
    class DonneesSauvegarde {
        - cheminImage : String
        - perspective1 : Perspective
        - perspective2 : Perspective
        + getCheminImage() : String
        + getPerspective1() : Perspective
        + getPerspective2() : Perspective
    }

    class GestionnaireSauvegarde {
        + {static} sauvegarder(donnees : DonneesSauvegarde, fichier : File) : void
        + {static} charger(fichier : File) : DonneesSauvegarde
    }
}

'CONTROLEUR'
package "Controleur" <<Rectangle>> {
    class ApplicationPrincipale {
        - imageModele : ImageModele
        - perspective1 : Perspective
        - perspective2 : Perspective
        - perspectiveActive : Perspective
        + start(stage : Stage) : void
        - ouvrirImage(stage : Stage) : void
        - sauvegarderPerspectives(stage : Stage) : void
        - chargerPerspectives(stage : Stage) : void
    }

    class ControleurPerspective {
        - perspective : Perspective
        - imageView : ImageView
        - initialiser() : void
    }
}

'RELATIONS'
CommandePerspective --> Perspective : modifie
GestionnaireCommande --> "*" Commande : gère

Perspective --> PerspectiveMemento : crée / restaure

VueVignette --> ImageModele : observe
VuePerspective --> ImageModele : observe
VuePerspective --> Perspective : observe
VuePerspective ..> GestionnaireCommande : utilise
VuePerspective ..> CommandePerspective : crée

PressePapierMediateur --> CopieStrategie : utilise
PressePapierMediateur --> PerspectiveMemento : stocke
PressePapierMediateur ..> Perspective : copie / colle

ApplicationPrincipale --> ImageModele
ApplicationPrincipale --> Perspective
ApplicationPrincipale --> VueVignette
ApplicationPrincipale --> VuePerspective
ApplicationPrincipale ..> GestionnaireCommande : utilise
ApplicationPrincipale ..> PressePapierMediateur : utilise
ApplicationPrincipale ..> GestionnaireSauvegarde : utilise

GestionnaireSauvegarde ..> DonneesSauvegarde

@enduml
